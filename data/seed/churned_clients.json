    "churned_accounts_ytd": "SELECT Id, Name, Closed_AMC_Date__c, Last_Order_Date__c, Days_Since_Last_Order__c, AMC_Client_Type__c, AMC_Closed_Lost_Reason__c, Owner.Name FROM Account WHERE Type = 'Past Client' AND RecordType.Name = 'Depository Institution' AND Closed_AMC_Date__c = THIS_YEAR ORDER BY Closed_AMC_Date__c DESC",
    "active_amc_logos": "SELECT COUNT(Id) n FROM Account WHERE Type = 'Client' AND RecordType.Name = 'Depository Institution' AND AMC_Client_Type__c != null",
    "active_depository_clients": "SELECT COUNT(Id) n FROM Account WHERE Type IN ('Client','New Client') AND RecordType.Name = 'Depository Institution'",
