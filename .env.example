# Copy to .env.local. Never commit real secrets.

# Production: managed Postgres connection string.
# Local dev and tests omit this and use embedded Postgres (PGlite) in PGLITE_DIR.
DATABASE_URL=
# Set to require on hosts that need TLS (Railway, Render, many managed Postgres).
DATABASE_SSL=

# Embedded Postgres directory used when DATABASE_URL is empty.
PGLITE_DIR=data/pglite

# First admin is created only when this password is set and the email does not exist yet.
# The password is never hard-coded. Default email is Carl@mountainseed.com.
ADMIN_EMAIL=Carl@mountainseed.com
ADMIN_PASSWORD=
ADMIN_NAME=Carl Streck

# Public origin used for invite / set-password links.
APP_BASE_URL=http://localhost:3000

# Session lifetime in hours.
SESSION_HOURS=18
# Secure session cookies. Leave unset to follow the request (https, or x-forwarded-proto).
# Set true behind a proxy that terminates TLS without forwarding the proto header.
# Set false only for a local http server.
COOKIE_SECURE=

# Bearer secret for the daily job endpoint (POST /api/cron/daily).
CRON_SECRET=

# In-process daily scheduler. Leave true on a long-running host (Render, Railway).
# On Vercel, set false and call /api/cron/daily from Vercel Cron instead.
ENABLE_DAILY_JOB=true
# Hour in UTC to run the daily Salesforce pull (11:00 UTC is 6:00 AM US Eastern standard time).
DAILY_JOB_UTC_HOUR=11

# Salesforce REST / SOQL. Leave blank to show "Not connected".
SF_LOGIN_URL=https://login.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_USERNAME=
SF_PASSWORD=
SF_SECURITY_TOKEN=
# Optional JSON object of query name -> SOQL, overriding the built-in queries.
SF_SOQL_JSON=
